# Identificador del formulario de Formspree: https://formspree.io/f/<id>
# Sin esta variable el formulario se degrada a un aviso con el correo directo.
NEXT_PUBLIC_FORMSPREE_ID=

# Token de GitHub con permiso read:user, para la traza de actividad del
# encabezado. Sin esta variable se usa el snapshot versionado del repo,
# rotulado con su fecha.
GITHUB_TOKEN=
